# x86_64 "q35" platform drivers (layered on kconf/base.config).
#
# QEMU's q35 machine: 8250/16550 serial (ttyS0), local+IO APIC, ACPI for
# enumeration/poweroff, HPET/TSC timers, the CMOS RTC, and ECAM PCI config
# (PCI_MMCONFIG). The analogue of kconf/arm64.config for Intel/AMD guests.
#
# NOTE: composed from kernel knowledge, validated via QEMU TCG emulation rather
# than on real x86 hardware -- see the plan's "Risks" section. olddefconfig
# resolves dependencies and may auto-enable some of these.

# 64-bit, SMP (for -smp), and the APICs (def_bool y on x86_64, listed for clarity)
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y

# ACPI: q35 enumeration + clean poweroff (allnoconfig strips it)
CONFIG_ACPI=y

# timers
CONFIG_HPET_TIMER=y

# ECAM PCI config space for the q35 PCIe host bridge
CONFIG_PCI_MMCONFIG=y

# serial console (ttyS0, legacy COM1 @ 0x3f8)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_PNP=y

# CMOS real-time clock (systemd/hwclock; sane guest time)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
