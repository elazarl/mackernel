# arm64 "virt" platform drivers (layered on kconf/base.config).
#
# QEMU's arm64 "virt" machine: PL011 serial (ttyAMA0), GICv3 interrupt
# controller, the architected timer, and PSCI for power management. Firmware is
# described via a flattened device tree (OF), and reset goes through a syscon.

# the arm64 "virt" PCIe ECAM host bridge -- the part tinyconfig misses. Without
# it the PCI bus is never enumerated and the virtio disk never appears.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_HOST_COMMON=y
CONFIG_PCI_ECAM=y

# serial console (ttyAMA0)
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# interrupt controller + timer + power management
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y

# reset/poweroff + device tree
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
