# Arch-independent base config: enough to boot the real init (systemd) under
# QEMU, find the virtio disk, mount an ext4 root, run cloud-init, and bring up
# sshd. Merged on top of `make tinyconfig`; the per-arch fragment
# (kconf/<arch>.config) adds the platform drivers (serial console, interrupt
# controller, timer, PCI host bridge, power/reset).
#
# Standard Kconfig-fragment format, applied via scripts/kconfig/merge_config.sh.

# console + printk
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y

# block layer + virtio disk
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y

# virtio networking + virtio entropy (so sshd/cloud-init do not stall on low entropy)
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# root filesystem
CONFIG_EXT4_FS=y

# run userspace binaries + scripts
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y

# almost nothing works without these
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y

# boot an initramfs (used by run-kernel-test.sh) + readable oops/sanitizer traces
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# debug symbols (attach with: qemu -s  +  gdb)
CONFIG_DEBUG_INFO_DWARF5=y

# === networking + cloud-init: enough kernel to boot the real init (systemd) ===
# so cloud-init runs, configures the NIC, and starts sshd we can reach from the host.

# TCP/IP stack: PACKET (dhcp), UNIX sockets (systemd/udev), INET, the netdev core.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y

# systemd prerequisites that tinyconfig (+EXPERT) strips out:
#   control-group hierarchy, the *fd/inotify/epoll syscalls, file locking, tmpfs/shmem,
#   process namespaces, and the proc sysctl interface.
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_FILE_LOCKING=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_UNIX98_PTYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# crypto bits sshd / systemd reach for
CONFIG_CRYPTO=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API_HASH=y

# the cloud image /boot/efi is a vfat partition; with no FAT support that mount
# fails, local-fs.target fails, and the boot drops to emergency mode (no sshd).
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y

# mount the cloud-init NoCloud seed (an ISO9660+Joliet disk labelled CIDATA).
# Joliet preserves the lowercase "user-data"/"meta-data" filenames, and pulls in NLS.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_DEFAULT="utf8"
